# GEMINI_API_KEY: Required for server-side Gemini AI Synergy calls (/api/cards/synergy).
# - AI Studio: Automatically injected at runtime from user secrets.
# - Vercel: Add GEMINI_API_KEY in Project Settings -> Environment Variables (Production, Preview, Development).
# - Render / Railway / Cloud Run: Set GEMINI_API_KEY in service environment variables.
# Note: If GEMINI_API_KEY is omitted, /api/cards/synergy automatically returns curated tactical synergy cards.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
